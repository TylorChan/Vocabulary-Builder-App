VITE_API_BASE_URL=https://api.your-domain.com
VITE_VOICE_BASE_URL=https://voice.your-domain.com
VITE_MEMORY_BASE_URL=https://memory.your-domain.com
VITE_BACKEND_BASE_URL=https://backend.your-domain.com
VITE_GRAPHQL_ENDPOINT=https://backend.your-domain.com/graphql
VITE_DEEPGRAM_RELAY_WS_URL=wss://api.your-domain.com

# REVIEW orchestration rollout. Keep strict turn gating disabled until V2 latency acceptance passes.
VITE_REVIEW_GRAPH_MODE=off
VITE_REVIEW_GRAPH_STRICT_TURN_GATE=false
REVIEW_GRAPH_MODE=off
REVIEW_GRAPH_CHECKPOINTER=mongo
REVIEW_GRAPH_STRICT_TURN_GATE=false
# V2 semantic evidence classifies each completed review turn before LangGraph updates teaching state.
REVIEW_SEMANTIC_EVIDENCE_ENABLED=true
# Event-driven replanning only runs after a Teaching Beat exhausts its deterministic support ladder.
REVIEW_BEAT_REPLANNER_ENABLED=true
OPENAI_REVIEW_TURN_EVIDENCE_MODEL=gpt-5.6-terra
OPENAI_REVIEW_TURN_EVIDENCE_REASONING_EFFORT=medium
GEMINI_TRANSCRIPT_REVIEW_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPT_REVIEW_THINKING_LEVEL=minimal
DEEPSEEK_TRANSCRIPT_REVIEW_MODEL=deepseek-v4-flash
DEEPSEEK_TRANSCRIPT_REVIEW_REASONING_EFFORT=none
TRANSCRIPT_REVIEW_TIMEOUT_MS=60000
# Keep local benchmark endpoints disabled on public production servers.
TRANSCRIPT_REVIEW_BENCHMARK_ENABLED=false
OPENAI_REVIEW_BEAT_REPLANNER_MODEL=gpt-5.6-terra
OPENAI_REVIEW_BEAT_REPLANNER_REASONING_EFFORT=high

# Proactive Free Chat Expression Assist. Keep both switches off until live gates pass.
VITE_EXPRESSION_ASSIST_ENABLED=false
EXPRESSION_ASSIST_ENABLED=false
OPENAI_EXPRESSION_ASSIST_MODEL=gpt-5.6-terra
OPENAI_EXPRESSION_ASSIST_REASONING_EFFORT=medium
OPENAI_EXPRESSION_ASSIST_EMBEDDING_MODEL=text-embedding-3-small
EXPRESSION_GAP_GATE_ENABLED=false
EXPRESSION_GAP_GATE_TIMEOUT_MS=5000
DEEPSEEK_EXPRESSION_GAP_GATE_MODEL=deepseek-v4-flash
DEEPSEEK_EXPRESSION_GAP_GATE_REASONING_EFFORT=none
VITE_EXPRESSION_ASSIST_TIMEOUT_MS=30000
EXPRESSION_ASSIST_TIMEOUT_MS=30000
VITE_EXPRESSION_ASSIST_GRAPH_MODE=off
EXPRESSION_ASSIST_GRAPH_MODE=off
EXPRESSION_ASSIST_GRAPH_CHECKPOINTER=mongo
VITE_EXPRESSION_ASSIST_GRAPH_TIMEOUT_MS=35000
EXPRESSION_RETRIEVAL_TIMEOUT_MS=10000
EXPRESSION_RETRIEVAL_DEADLINE_MS=20000
EXPRESSION_RETRIEVAL_MAX_ATTEMPTS=3
VITE_REALTIME_TURN_SETTLE_MS=1000
VITE_VOICE_SESSION_TRACE_ENABLED=false
VOICE_SESSION_TRACE_ENABLED=false
EXPRESSION_RETRIEVAL_COLLECTION=expression_retrieval_documents
EXPRESSION_RETRIEVAL_VECTOR_INDEX=expression_vector_index
VOCABULARY_COLLECTION_NAME=vocabulary_entries

# Optional: single endpoint
VITE_FSRS_REVIEW_ENDPOINT=https://fsrs.your-domain.com/review

# Optional: multiple endpoints fallback (comma-separated)
VITE_FSRS_REVIEW_ENDPOINTS=https://fsrs1.your-domain.com/review,https://fsrs2.your-domain.com/review
